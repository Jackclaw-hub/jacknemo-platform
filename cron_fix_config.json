{
  "models": {
    "mode": "replace",
    "providers": {
      "inference": {
        "baseUrl": "https://integrate.api.nvidia.com/v1",
        "apiKey": "__OPENCLAW_REDACTED__",
        "api": "openai-completions",
        "models": [
          {
            "id": "deepseek-ai/deepseek-v3.1",
            "name": "inference/deepseek-ai/deepseek-v3.1",
            "reasoning": false,
            "input": ["text"],
            "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
            "contextWindow": 131072,
            "maxTokens": 4096  // Reduced to prevent token limit issues
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "inference/deepseek-ai/deepseek-v3.1",
        "fallbacks": []  // No fallbacks to prevent OpenRouter usage
      },
      "compaction": {"mode": "safeguard"},
      "heartbeat": {"every": "30m", "target": "last", "lightContext": true},
      "timeoutSeconds": 300  // Reduced timeout
    }
  }
}